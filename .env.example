# Copy to .env.local for local development. Never commit real values.
# Public values (bundled into the browser). Only these two may start with VITE_.
VITE_SUPABASE_URL=https://fauotybbzqlerctitcsc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only (Vercel environment variables, never VITE_ prefixed).
SUPABASE_URL=https://fauotybbzqlerctitcsc.supabase.co
# Supabase secret key (sb_secret_...) or the legacy service_role key. Bypasses RLS: server only.
SUPABASE_SERVICE_ROLE_KEY=
# Claude API key from console.anthropic.com.
ANTHROPIC_API_KEY=
# Resend API key and a sender on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=Nexa <noreply@example.com>
# Public base URL of the app, no trailing slash, for links in emails and calendar feeds.
APP_URL=http://localhost:5173
# At least 32 random bytes, base64. Derives invite codes, calendar tokens and rate limit buckets.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
TOKEN_SECRET=
# Shared secret that Supabase pg_cron sends to the cron endpoints.
CRON_SECRET=
# Set to 1 in tests to return fixed AI results instead of calling the Claude API.
AI_MOCK=0
