{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/document/**",
              "components/slides/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Hanken Grotesk|Source Serif 4))/i]",
        "message": "Font not provided by the design system. Available: Hanken Grotesk, Source Serif 4."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|highlight|max|size|unit|categoryLabel|valueLabel|baseline|key|ref|className|style|children)$/]",
        "message": "<BarChart> doesn't accept that prop. Declared props: data, highlight, max, size, unit, categoryLabel, valueLabel, baseline."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChart'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:slide|compact)$/]",
        "message": "<BarChart> size must be one of 'slide' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlockQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|citation|key|ref|className|style|children)$/]",
        "message": "<BlockQuote> doesn't accept that prop. Declared props: children, citation."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|data|highlight|categoryLabel|valueLabel|meta|source|page|key|ref|className|style|children)$/]",
        "message": "<ChartSlide> doesn't accept that prop. Declared props: title, description, data, highlight, categoryLabel, valueLabel, meta, source, page."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClosingSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|key|ref|className|style|children)$/]",
        "message": "<ClosingSlide> doesn't accept that prop. Declared props: title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|points|meta|footer|key|ref|className|style|children)$/]",
        "message": "<ContentSlide> doesn't accept that prop. Declared props: title, points, meta, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverPage'] > JSXAttribute > JSXIdentifier[name!=/^(?:institution|programme|label|title|subtitle|fields|key|ref|className|style|children)$/]",
        "message": "<CoverPage> doesn't accept that prop. Declared props: institution, programme, label, title, subtitle, fields."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|columns|rows|highlight|widths|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: number, title, columns, rows, highlight, widths."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocPage'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|pageNumber|label|children|style|key|ref|className|style|children)$/]",
        "message": "<DocPage> doesn't accept that prop. Declared props: header, pageNumber, label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|caption|source|src|placeholder|ratio|width|key|ref|className|style|children)$/]",
        "message": "<Figure> doesn't accept that prop. Declared props: number, caption, source, src, placeholder, ratio, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footnotes'] > JSXAttribute > JSXIdentifier[name!=/^(?:notes|key|ref|className|style|children)$/]",
        "message": "<Footnotes> doesn't accept that prop. Declared props: notes."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupedBarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:categories|series|max|height|gridlines|note|key|ref|className|style|children)$/]",
        "message": "<GroupedBarChart> doesn't accept that prop. Declared props: categories, series, max, height, gridlines, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|first|children|style|key|ref|className|style|children)$/]",
        "message": "<Heading> doesn't accept that prop. Declared props: level, first, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|src|alt|ratio|tone|fontSize|grayscale|style|key|ref|className|style|children)$/]",
        "message": "<ImagePlaceholder> doesn't accept that prop. Declared props: children, src, alt, ratio, tone, fontSize, grayscale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlaceholder'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mist|sage)$/]",
        "message": "<ImagePlaceholder> tone must be one of 'mist' | 'sage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|imageLabel|title|body|meta|credit|page|key|ref|className|style|children)$/]",
        "message": "<ImageSlide> doesn't accept that prop. Declared props: src, imageLabel, title, body, meta, credit, page."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|size|style|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: children, color, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:ink|graphite|rust|sage|paper)$/]",
        "message": "<Label> color must be one of 'ink' | 'graphite' | 'rust' | 'sage' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Paragraph'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|last|style|key|ref|className|style|children)$/]",
        "message": "<Paragraph> doesn't accept that prop. Declared props: children, last, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|attribution|meta|footer|size|key|ref|className|style|children)$/]",
        "message": "<QuoteSlide> doesn't accept that prop. Declared props: quote, attribution, meta, footer, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReferenceList'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|entries|key|ref|className|style|children)$/]",
        "message": "<ReferenceList> doesn't accept that prop. Declared props: title, entries."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionDivider'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|name|label|key|ref|className|style|children)$/]",
        "message": "<SectionDivider> doesn't accept that prop. Declared props: number, name, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slide'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|label|children|style|key|ref|className|style|children)$/]",
        "message": "<Slide> doesn't accept that prop. Declared props: tone, label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slide'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|ink|mist)$/]",
        "message": "<Slide> tone must be one of 'paper' | 'ink' | 'mist'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideMeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|position|left|right|color|key|ref|className|style|children)$/]",
        "message": "<SlideMeta> doesn't accept that prop. Declared props: items, position, left, right, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideMeta'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<SlideMeta> position must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableOfContents'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|entries|key|ref|className|style|children)$/]",
        "message": "<TableOfContents> doesn't accept that prop. Declared props: title, entries."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|place|title|meta|key|ref|className|style|children)$/]",
        "message": "<TitleSlide> doesn't accept that prop. Declared props: label, place, title, meta."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
